    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SnoozeIt.Service</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
