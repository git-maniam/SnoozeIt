<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SnoozeIt_Client.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SnoozeIt_Client"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Metrics Banner -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="16">
                <TextBlock Text="RAM Usage" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total RAM" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TotalRamTextBlock" Text="0.0 GB" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Used RAM" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="UsedRamTextBlock" Text="0.0 GB" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Reclaimed RAM" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ReclaimedRamTextBlock" Text="0.0 MB" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Snoozed Workloads" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SnoozedCountTextBlock" Text="0 Apps" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Execution Engine" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ServiceStatusTextBlock" Text="Active Service Mode" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Normal" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                        <HyperlinkButton x:Name="AboutLinkBtn" Content="About-SnoozeIt"
                                         HorizontalAlignment="Right"
                                         Padding="0" Margin="0,0,0,2"
                                         FontSize="12"
                                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                         Click="OnAboutLinkClicked" />
                        <Button x:Name="SnoozeAllBtn" Content="⚡ Snooze All Safe"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="OnSnoozeAllClicked" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Feedback InfoBar / Status Banner -->
        <InfoBar x:Name="ActionInfoBar" Grid.Row="1" IsOpen="False" Severity="Informational" />

        <!-- Search & Control Bar -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search active processes or service groups..." TextChanged="OnSearchTextChanged" />
            <Button x:Name="RefreshBtn" Grid.Column="1" Content="🔄 Refresh" Click="OnRefreshClicked" />
        </Grid>

        <!-- Tree View: Grouped Process Expander List -->
        <ListView x:Name="ProcessGroupListView" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,3">
                        <Expander.Header>
                            <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Process Group Title & Count -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding InstanceCountFormatted}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding GroupName}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Total Working Set for Group -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Group RAM" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding TotalWorkingSetFormatted}" Style="{ThemeResource BodyTextBlockStyle}" />
                                </StackPanel>

                                <!-- Peak Snooze Score -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Snooze Score" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding ScoreDisplay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>

                                <!-- Group Status -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="Status" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>

                                <!-- Group Slider Action -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                    <ToggleSwitch Header="Snooze &amp; Wake"
                                                  OffContent="Awake"
                                                  OnContent="Snoozed"
                                                  IsOn="{Binding IsSnoozed, Mode=OneWay}"
                                                  IsEnabled="{Binding IsSafeToSnooze}"
                                                  Toggled="OnGroupToggleToggled"
                                                  Tag="{Binding}" />
                                    <TextBlock Text="Unsafe to Snooze"
                                               Foreground="#FFFF4D4D"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding UnsafeVisibility}"
                                               Margin="0,-4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <!-- Expanded Child Process Instances (Tree Nodes) -->
                        <Expander.Content>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="16,8,8,8" Margin="0,2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                              CornerRadius="4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Instance PID badge -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="3" Padding="6,2">
                                                    <TextBlock Text="{Binding PidDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- RAM -->
                                            <TextBlock Grid.Column="1" Text="{Binding WorkingSetFormatted}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />

                                            <!-- Score -->
                                            <TextBlock Grid.Column="2" Text="{Binding ScoreDisplay}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />

                                            <!-- Status -->
                                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />

                                            <!-- Child Slider Action -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                <ToggleSwitch OffContent="Awake"
                                                              OnContent="Snoozed"
                                                              IsOn="{Binding IsSnoozed, Mode=OneWay}"
                                                              IsEnabled="{Binding IsSafeToSnooze}"
                                                              Toggled="OnItemToggleToggled"
                                                              Tag="{Binding}" />
                                                <TextBlock Text="Unsafe to Snooze"
                                                           Foreground="#FFFF4D4D"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Visibility="{Binding UnsafeVisibility}"
                                                           Margin="0,-4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander.Content>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- About SnoozeIt Splash Screen / Modal Overlay -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="4" Margin="-24" Background="#99000000"
              Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Canvas.ZIndex="1000" PointerPressed="OnAboutOverlayPointerPressed">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28"
                    MaxWidth="680"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header: Title & Close 'X' Button -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" Width="32" Height="32" />
                            <TextBlock Text="About SnoozeIt" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="AboutHeaderCloseBtn" Grid.Column="1" Content="✕"
                                Style="{ThemeResource SubtleButtonStyle}"
                                FontSize="14" FontWeight="Bold"
                                Width="36" Height="36" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="OnAboutCloseClicked" />
                    </Grid>

                    <!-- Modal Content: ScrollViewer with About-SnoozeIt.md content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="0,4,12,4">
                            <TextBlock Text="SnoozeIt is provided free of charge for personal and commercial use, without warranties or guarantees of any kind."
                                       TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />

                            <TextBlock Text="As a developer, I created this tool to help fellow developers. I experienced high RAM usage during builds, while RAM prices have increased significantly due to the AI boom. Not every developer can afford to upgrade their machine regularly."
                                       TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />

                            <TextBlock Text="SnoozeIt helps address this problem by intelligently pausing services such as Docker Desktop during build phases or other services during unit-test runs, helping conserve RAM and system resources."
                                       TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="You can find the source code at:"
                                           TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />
                                <HyperlinkButton Content="https://github.com/git-maniam/SnoozeIt"
                                                 NavigateUri="https://github.com/git-maniam/SnoozeIt"
                                                 Click="OnGitHubLinkClicked"
                                                 Padding="0" FontWeight="SemiBold"
                                                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Feel free to use it, fork it, modify it, or do whatever you like with it—but please continue sharing it freely with others."
                                           TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />
                            </StackPanel>

                            <TextBlock Text="Developers are already facing increasing competition from AI. By making small, useful tools like this freely available, we can support and strengthen our developer community."
                                       TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6" />

                            <TextBlock Text="About Me" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />

                            <TextBlock Text="I am a developer at heart and a Principal Technical Program Manager by profession, based in Bangalore, India."
                                       TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />

                            <TextBlock Text="I will never ask for money or donations for tools like this. If you would like to do something meaningful, consider donating to a charity of your choice—for example, one that helps children learn new skills or supports elderly people in need. The choice is entirely yours."
                                       TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer: Close Button -->
                    <Grid Grid.Row="2">
                        <Button x:Name="AboutFooterCloseBtn" Content="Close"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Right" MinWidth="100"
                                Click="OnAboutCloseClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
