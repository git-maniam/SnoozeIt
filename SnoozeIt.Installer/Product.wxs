<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="SnoozeIt" Language="1033" Version="1.0.0.0" Manufacturer="SnoozeIt" UpgradeCode="{11111111-1111-1111-1111-111111111111}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <Media Id="1" Cabinet="cab1.cab" EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="SnoozeIt">
          <Component Id="ServiceExe" Guid="{33333333-3333-3333-3333-333333333333}" Win64="yes">
            <File Id="ServiceExeFile" Source="..\publish\service\SnoozeIt.Service.exe" KeyPath="yes" />
            <ServiceInstall Id="SnoozeItServiceInstall" Type="ownProcess" Name="SnoozeIt.Service" DisplayName="SnoozeIt Service" Start="auto" ErrorControl="normal" />
            <ServiceControl Id="SnoozeItServiceControl" Name="SnoozeIt.Service" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="SnoozeIt">
          <Component Id="ApplicationShortcut" Guid="{44444444-4444-4444-4444-444444444444}">
            <Shortcut Id="ApplicationStartMenuShortcut"
                      Name="SnoozeIt"
                      Description="Autonomous Process Hibernation &amp; Working Set Eviction Engine"
                      Target="[INSTALLFOLDER]SnoozeIt.Client.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\SnoozeIt" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="DefaultFeature" Level="1">
      <ComponentGroupRef Id="ClientComponents" />
      <ComponentRef Id="ServiceExe" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Product>
</Wix>
